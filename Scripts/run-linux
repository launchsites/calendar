#!/usr/bin/env bash
set -euo pipefail
cd -- "${BASH_SOURCE[0]%/*}/.."

bin="$PWD/.build/release/calendar-linux-core"
if [[ ! -x .build/linux-venv/bin/python || ! -x "$bin" ]]; then
    echo "Run Scripts/setup-linux first." >&2
    exit 1
fi
exec .build/linux-venv/bin/python -X faulthandler Linux/calendar_app.py --core "$bin" "$@"
